<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-ios</TargetFrameworks>
        <RootNamespace>BareUI</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>

        <PackageId>BareUI.iOS</PackageId>
        <Version>0.1.0</Version>
        <Description>Declarative, WPF-inspired UI library for .NET for iOS. Native UIKit controls behind a clean C# syntax with AOT-safe MVVM bindings.</Description>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0-ios' ">
        <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    </PropertyGroup>
</Project>
