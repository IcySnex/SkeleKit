<Project>

	<!-- SkeleKit's debugger bridge is a TCP proxy. Make the app and Rider both select the network
	     debugger transport for hot-reload sessions. This is harmless for simulator builds and avoids
	     Rider misclassifying a network-paired physical device as USB-connected. -->
	<PropertyGroup Condition=" '$(EnableHotReload)' == 'true' And '$(Configuration)' == 'Debug' ">
		<IOSDebugOverWiFi>true</IOSDebugOverWiFi>
		<IOSDebuggerConnectOverUsb>false</IOSDebuggerConnectOverUsb>
	</PropertyGroup>

	<!-- Configures MetadataUpdater for simulator hot reload. Physical-device interpreter support is
	     handled separately; selecting the network debugger above still enables normal device debug. -->

	<PropertyGroup Condition=" '$(EnableHotReload)' == 'true' And '$(Configuration)' == 'Debug' And $(RuntimeIdentifier.StartsWith('iossimulator')) ">
		<_SkeleHotReload>true</_SkeleHotReload>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(_SkeleHotReload)' == 'true' ">
		<!-- ships libmono-component-hot_reload.dylib and lets the interpreter apply deltas -->
		<UseInterpreter>true</UseInterpreter>
		<!-- so the after-build target can read @(CscCommandLineArgs) -->
		<ProvideCommandLineArgs>true</ProvideCommandLineArgs>
	</PropertyGroup>

	<ItemGroup Condition=" '$(_SkeleHotReload)' == 'true' ">
		<!-- Keep SkeleKit.iOS metadata stable so Rider can baseline and hot reload library methods.
		     Other framework/runtime assemblies still use the normal iOS Debug trim mode. -->
		<TrimmerRootAssembly Include="SkeleKit.iOS" />
		<!-- Trim="true" is load-bearing: without it the linker bakes IsSupported to a constant false -->
		<RuntimeHostConfigurationOption Include="System.Reflection.Metadata.MetadataUpdater.IsSupported" Value="true" Trim="true" />
		<RuntimeEnvironmentVariable Include="DOTNET_MODIFIABLE_ASSEMBLIES" Value="debug" />
	</ItemGroup>

	<!-- the packed host (tools/) in a real package; the repo build output when developing SkeleKit -->
	<PropertyGroup Condition=" '$(SkeleHotReloadHost)' == '' And Exists('$(MSBuildThisFileDirectory)../tools/hotreload/skele-hotreload.dll') ">
		<SkeleHotReloadHost>$(MSBuildThisFileDirectory)../tools/hotreload/skele-hotreload.dll</SkeleHotReloadHost>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(SkeleHotReloadHost)' == '' ">
		<SkeleHotReloadHost>$(MSBuildThisFileDirectory)../bin/Release/net10.0/skele-hotreload.dll</SkeleHotReloadHost>
	</PropertyGroup>

	<!-- Records the compiler inputs the bridge needs (references, defines, source generators). The
	     bridge itself is started by skele-debug.sh, not here, so a build-only leaves nothing running. -->
	<Target Name="SkeleWriteHotReloadArgs" AfterTargets="Build" Condition=" '$(_SkeleHotReload)' == 'true' ">
		<!-- only when CoreCompile actually ran; an up-to-date build reuses the previous args file -->
		<WriteLinesToFile
			File="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)skelekit-hotreload.args"
			Lines="@(CscCommandLineArgs)"
			Overwrite="true"
			Condition=" '@(CscCommandLineArgs)' != '' " />
	</Target>

</Project>
