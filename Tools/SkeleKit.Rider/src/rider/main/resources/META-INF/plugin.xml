<idea-plugin require-restart="true">
  <id>com.skelekit.rider</id>
  <name>SkeleKit</name>
  <vendor url="https://github.com/IcySnex/SkeleKit">SkeleKit</vendor>
  <depends>com.intellij.modules.rider</depends>

  <description>
<![CDATA[
<p>Hot reload and breakpoints together for SkeleKit.iOS apps running in the iOS simulator.</p>
]]>
  </description>

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="com.skelekit.rider.ios.IosPortInstrumenter"/>
    <postStartupActivity implementation="com.skelekit.rider.ios.BridgePortPublisher"/>
  </extensions>

</idea-plugin>
