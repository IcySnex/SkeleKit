<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <ApplicationId>com.skelekit.gallery</ApplicationId>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <CodesignKey>iPhone Developer</CodesignKey>
      <EnableHotReload>true</EnableHotReload>
    </PropertyGroup>

    <!-- Opt-in hot reload: build with -p:EnableHotReload=true (or set it in the Rider run config).
         The Mono interpreter ships the runtime's hot_reload component and the feature switch (baked
         true by Trim="true") flips MetadataUpdater.IsSupported on, which the delta applier needs.
         Off by default so a normal Debug build stays on the faster JIT. -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' And '$(EnableHotReload)' == 'true' ">
      <UseInterpreter>true</UseInterpreter>
    </PropertyGroup>
    <ItemGroup Condition=" '$(Configuration)' == 'Debug' And '$(EnableHotReload)' == 'true' ">
      <RuntimeHostConfigurationOption Include="System.Reflection.Metadata.MetadataUpdater.IsSupported" Value="true" Trim="true" />
      <RuntimeEnvironmentVariable Include="DOTNET_MODIFIABLE_ASSEMBLIES" Value="debug" />
    </ItemGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <CodesignKey>iPhone Developer</CodesignKey>
      <MtouchLink>Full</MtouchLink>
      <DeviceSpecificBuild>true</DeviceSpecificBuild>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' == 'ios-arm64' ">
      <MtouchLink>Full</MtouchLink>
      <TrimmerSingleWarn>false</TrimmerSingleWarn>
      <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SkeleKit.iOS\SkeleKit.iOS.csproj" />
        <ProjectReference Include="..\..\SkeleKit.Generators\SkeleKit.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>
</Project>
