<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet publish Samples/SkeleKit.Gallery -p:PublishProfile=iOS-Device
     Or in Rider: right-click the project > Publish > iOS-Device. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-ios</TargetFramework>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Release\net10.0-ios\ios-arm64\publish\</PublishDir>

    <!-- .ipa for distribution; the plain .app is what devicectl installs -->
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <BuildIpa>true</BuildIpa>
  </PropertyGroup>
</Project>
