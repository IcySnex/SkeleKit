<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-ios</TargetFrameworks>
        <RootNamespace>SkeleKit</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>

        <PackageId>SkeleKit.iOS</PackageId>
        <Version>0.1.0</Version>
        <Description>A C# UI framework for native iOS - real UIKit controls, no storyboards or constraints, zero boilerplate.</Description>
        <RepositoryUrl>https://github.com/IcySnex/SkeleKit</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0-ios' ">
        <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- The package ships iOS only. The net10.0 shim exists so the layout engine can be tested without a simulator. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SkeleKit.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <Compile Remove="App/**" />
    </ItemGroup>

    <!-- net10.0 is a test shim, not a platform: UIKit-touching code is compiled out of it by file. -->
    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <Compile Remove="Controls/**" />
        <Compile Remove="Animation/Animator.cs" />
        <Compile Remove="**/*.iOS.cs" />
        <Compile Remove="Elements/LayoutHost.cs" />
        <Compile Remove="Elements/AccessoryHost.cs" />
        <Compile Remove="Primitives/Fonts.cs" />
        <Compile Remove="Primitives/Keyboards.cs" />
        <Compile Remove="Primitives/ItemKey.cs" />
    </ItemGroup>
</Project>
