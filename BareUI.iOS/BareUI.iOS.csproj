<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-ios</TargetFrameworks>
        <RootNamespace>BareUI</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>

        <PackageId>BareUI.iOS</PackageId>
        <Version>0.1.0</Version>
        <Description>Declarative, WPF-inspired UI library for .NET for iOS. Native UIKit controls behind a clean C# syntax with AOT-safe MVVM bindings.</Description>
        <RepositoryUrl>https://github.com/IcySnex/BareUI</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591: self-describing members (Colors.Red) carry no summary on purpose -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0-ios' ">
        <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <!-- The package ships iOS only. The net10.0 shim exists so the layout engine can be tested
         without a simulator; shipping it would hand consumers a hollow lib with no controls. -->
    <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <IncludeBuildOutput>false</IncludeBuildOutput>
    </PropertyGroup>

    <PropertyGroup>
        <!-- NU5128: the shim TFM has no lib/, which is the point -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BareUI.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <Compile Remove="App/**" />
    </ItemGroup>

    <!-- net10.0 is a test shim, not a platform: it exists so BareUI.Tests can run the layout
         engine without a simulator. UIKit-touching code is compiled out of it by file, not by #if. -->
    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <Compile Remove="Controls/**" />
        <Compile Remove="Animation/**" />
        <Compile Remove="**/*.iOS.cs" />
        <Compile Remove="Elements/LayoutHost.cs" />
        <Compile Remove="Primitives/Fonts.cs" />
        <Compile Remove="Primitives/Keyboards.cs" />
    </ItemGroup>
</Project>
