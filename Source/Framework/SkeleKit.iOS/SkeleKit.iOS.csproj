<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-ios27.0</TargetFrameworks>
        <NoWarn>XCODE_27_0_PREVIEW</NoWarn>
        <RootNamespace>SkeleKit</RootNamespace>
        <IsPackable>true</IsPackable>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <PackageId>SkeleKit.iOS</PackageId>
        <Version>$(SkeleKitPackageVersion)</Version>
        <Title>SkeleKit for iOS</Title>
        <Authors>IcySnex</Authors>
        <Company>SkeleKit</Company>
        <Description>Native, code-first UI framework for .NET for iOS. Build UIKit apps with C# object initializers, AOT-safe MVVM bindings, layout, navigation, and controls—without MAUI or XAML.</Description>
        <PackageProjectUrl>https://github.com/IcySnex/SkeleKit</PackageProjectUrl>
        <RepositoryUrl>https://github.com/IcySnex/SkeleKit</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageTags>skelekit;ios;uikit;dotnet-ios;ui-framework;mvvm;aot;csharp</PackageTags>
        <PackageIcon>package-icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes><![CDATA[- Add native split views as app shell, tab destination or sidebar destination.
- Add adaptive layout configuration to split views.
- Add TabPlacement.Hidden for destinations that are only reached programmatically.
- Add global Theme on SkeleApplication combining tint, appearance, navigation title style, top scroll edge and tab bar minimization.
- Inherit Theme.NavigationTitleStyle and Theme.TopScrollEdgeStyle and apply theme changes live.
- Add IMailer to compose mails.
- Fix navigation bar accessory not respecting safe area.
- Rename implicit styles API (Theme to Styles).
- Add CollectionLayout.FixedGrid: a visible-only grid for large virtualized sources.
- Add virtualized items and sections sources for very large collections, with major collection optimizations.
- Rename InitialScrollPosition to DefaultScrollPosition and land system scroll-to-top gestures there.
- Add native accessories to item views.
- Make more view properties bindable.
- Add dotted border strokes.
- Add item aspect ratio to grid layouts.
- Allow hiding the collection scroll indicator.
- Fix action bubble placement and activation on iOS 18 and 27.
- Cache color conversions for faster cell rebinds.
- Fix application startup deadlocking with awaited lifecycle services.]]></PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <Copyright>Copyright © IcySnex</Copyright>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>

        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../Packaging/README.md" Pack="true" PackagePath="/" />
        <None Include="../../../Assets/icon/package.png" Pack="true" PackagePath="package-icon.png" />
        <None Include="build/SkeleKit.iOS.targets" Pack="true" PackagePath="buildTransitive/SkeleKit.iOS.targets" />
        <None Include="../SkeleKit.Generators/bin/$(Configuration)/netstandard2.0/SkeleKit.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />

        <ProjectReference Include="../SkeleKit.Generators/SkeleKit.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' ">
        <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <NoWarn>$(NoWarn);CS1574</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <Compile Remove="Controls/**" />
        <Compile Remove="Animation/Animator.cs" />
        <Compile Remove="**/*.iOS.cs" />
        <Compile Remove="Elements/LayoutHost.cs" />
        <Compile Remove="Elements/AccessoryHost.cs" />
        <Compile Remove="Primitives/Fonts.cs" />
        <Compile Remove="Primitives/Keyboards.cs" />
        <Compile Remove="Primitives/ItemKey.cs" />
        <Compile Remove="App/**" />

        <Compile Include="App/Appearance.cs" />
		<Compile Include="App/Builder/GroupBuilder.cs" />
        <Compile Include="App/Builder/PagesBuilder.cs" />
		<Compile Include="App/Builder/SidebarBuilder.cs" />
		<Compile Include="App/Builder/SplitViewBuilder.cs" />
		<Compile Include="App/Builder/TabsBuilder.cs" />
        <Compile Include="App/Builder/ThemeBuilder.cs" />
        <Compile Include="App/Navigation/Detent.cs" />
        <Compile Include="App/Navigation/PageAttribute.cs" />
        <Compile Include="App/Navigation/ViewRegistry.cs" />
        <Compile Include="App/Theme.cs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SkeleKit.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.303" PrivateAssets="all" />
    </ItemGroup>
</Project>
